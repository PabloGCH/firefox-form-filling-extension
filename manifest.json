{
  "manifest_version": 2,
  "name": "AI Form Filler",
  "version": "0.1.0",
  "description": "Fill web forms with session-only personal information and a user-configured model.",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "119.0"
    }
  },
  "permissions": ["<all_urls>", "notifications"],
  "background": {
    "scripts": [
      "src/shared/constants.js",
      "src/shared/validators.js",
      "src/background/session-state.js",
      "src/background/prompt-constants.js",
      "src/background/prompt-builder.js",
      "src/background/model-response.js",
      "src/background/model-constants.js",
      "src/background/model-client.js",
      "src/background/index.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "AI Form Filler",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
