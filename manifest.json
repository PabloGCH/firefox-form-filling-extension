{
  "manifest_version": 2,
  "name": "AI Form Filler",
  "version": "0.1.0",
  "description": "Fill web forms with session-only personal information and a user-configured model.",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "119.0"
    }
  },
  "permissions": ["<all_urls>", "notifications"],
  "background": {
    "scripts": [
      "src/shared/constants.js",
      "src/shared/validators.js",
      "src/background/session-state.js",
      "src/background/prompt-constants.js",
      "src/background/prompt-builder.js",
      "src/background/model-response.js",
      "src/background/model-constants.js",
      "src/background/model-client.js",
      "src/background/notifications.js",
      "src/background/index.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "AI Form Filler",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/constants.js",
        "src/content/visibility.js",
        "src/content/panel.js",
        "src/content/safety-gate.js",
        "src/content/picker.js",
        "src/content/field-labels.js",
        "src/content/field-collector.js",
        "src/content/select-matcher.js",
        "src/content/select-handler.js",
        "src/content/submit-guard.js",
        "src/content/field-filler.js",
        "src/content/dependent-dropdowns.js",
        "src/content/fill-summary.js",
        "src/content/fill-flow.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
